# Copy to .env for Docker Compose. Generate fresh secrets; never commit .env.
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password
JWT_SECRET=replace_with_at_least_32_random_characters

# Backend-only VPS Compose (compose.backend.yaml).
BACKEND_IMAGE=hoangphat120805/booking-backend:latest
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8080
JWT_EXPIRE_TIME=3600
# Set to the actual reverse proxy IP/CIDR when using one.
TRUSTED_PROXIES=
