DB_STR="host=localhost port=5432 user=booking password=replace_me dbname=booking sslmode=disable"
JWT_SECRET="replace_with_at_least_32_random_characters"
JWT_EXPIRE_TIME=3600
SERVER_ADDR=:8080

# Backend-only Docker Compose. DB_STR above is for running Go on the host;
# Compose sets its own DB_STR pointing to the db service.
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_password
BACKEND_IMAGE=hoangphat120805/booking-backend:latest
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8080
# Actual reverse proxy IP/CIDR, when using one.
TRUSTED_PROXIES=
